{
  "name": "naryady",
  "productName": "Наряды",
  "version": "1.6.0",
  "description": "Честное распределение нарядов роты",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "vite build && electron-builder --win portable",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "build": {
    "appId": "ru.rota.naryady",
    "productName": "Наряды",
    "artifactName": "Naryady-${version}.exe",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "docx": "^9.14.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
